{
  "name": "quarry-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "document:build": "bun scripts/build-document.mjs",
    "dev": "bun run document:build --dev && vite --host 127.0.0.1",
    "build": "bun run document:build && tsc -b && vite build",
    "test": "bun run document:build --dev && NODE_OPTIONS=--no-warnings vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:watch": "bun run document:build --dev && vitest",
    "typecheck": "bun run document:build --dev && tsc -b",
    "generate:api": "bun run scripts/generate-api.ts",
    "check:architecture": "python3 ../scripts/check-document-architecture.py",
    "test:performance": "bun run build && bun scripts/build-server.mjs --release && QUARRY_PERFORMANCE=1 QUARRY_PRODUCTION_UI=1 playwright test -c playwright.live.config.ts --workers=1",
    "benchmark:document": "bun run document:build && bun scripts/benchmark-document.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@platejs/autoformat": "52.0.11",
    "@platejs/basic-nodes": "52.0.11",
    "@platejs/code-block": "52.0.11",
    "@platejs/dnd": "52.0.11",
    "@platejs/floating": "52.0.11",
    "@platejs/link": "52.0.11",
    "@platejs/list": "52.0.11",
    "@platejs/markdown": "52.1.0",
    "@platejs/media": "52.0.11",
    "@platejs/resizable": "52.0.11",
    "@platejs/table": "52.0.11",
    "@platejs/toc": "52.0.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "cmdk": "1.1.1",
    "dnd-core": "14.0.1",
    "lucide-react": "0.555.0",
    "marked": "15.0.12",
    "mdast-util-mdx-jsx": "3.2.0",
    "mermaid": "^11.15.0",
    "micromark-extension-mdx-jsx": "3.0.2",
    "nanoid": "5.1.11",
    "platejs": "52.0.17",
    "react": "19.2.1",
    "react-arborist": "3.4.3",
    "react-dnd": "14.0.5",
    "react-dnd-html5-backend": "14.1.0",
    "react-dom": "19.2.1",
    "react-resizable-panels": "3.0.6",
    "react-router-dom": "7.9.6",
    "remark-gfm": "4.0.1",
    "swr": "2.3.6",
    "tailwind-merge": "3.4.0",
    "unist-util-visit": "5.1.0",
    "yaml": "^2.9.0",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@hey-api/openapi-ts": "0.86.3",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "27.2.0",
    "playwright": "1.57.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.7",
    "vitest": "4.0.15"
  },
  "patchedDependencies": {
    "slate-react@0.120.0": "patches/slate-react@0.120.0.patch",
    "@platejs/table@52.0.11": "patches/@platejs%2Ftable@52.0.11.patch",
    "react-dom@19.2.1": "patches/react-dom@19.2.1.patch"
  }
}
